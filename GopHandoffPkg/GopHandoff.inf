[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = GopHandoff
  FILE_GUID                      = 0C877756-6693-4A04-9BA8-77BFB02BD8BE
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 0.2.15
  ENTRY_POINT                    = GopHandoffEntryPoint
  UNLOAD_IMAGE                   = GopHandoffUnload

[Sources]
  GopHandoff.c
  Common/GopFramebufferProtocol.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseMemoryLib
  MemoryAllocationLib
  CommonMemoryAllocationLib
  MemoryProfileLib
  DebugLib
  DevicePathLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
  UefiRuntimeServicesTableLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid
  gEfiPciIoProtocolGuid
  gEfiEdidActiveProtocolGuid
  gEfiEdidDiscoveredProtocolGuid

[Depex]
  TRUE

[BuildOptions]
  GCC:*_*_*_CC_FLAGS             = -Wall -Wextra -Werror -Wformat=2 -Wshadow -Wconversion -Wsign-conversion -DGOPFB_EDK2=1 -Wno-unused-parameter
  XCODE:*_*_*_CC_FLAGS       = -Wall -Wextra -Werror -Wformat=2 -Wshadow -Wconversion -Wsign-conversion -DGOPFB_EDK2=1 -Wno-unused-parameter
  XCODE:*_*_*_CXX_FLAGS     = -Wall -Wextra -Werror -Wformat=2 -Wshadow -Wconversion -Wsign-conversion -DGOPFB_EDK2=1 -Wno-unused-parameter
